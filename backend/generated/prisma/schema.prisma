// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuarios {
  id     Int     @id @default(autoincrement())
  nome   String  @db.VarChar(120)
  senha  String
  email  String  @unique
  status Boolean @default(true)

  dt_nascimento DateTime? @db.Date

  dh_criacao      DateTime          @default(now())
  dh_alteracao    DateTime          @default(now())
  grupoEmpresas   GrupoEmpresas[]
  empresaUsuarios EmpresaUsuarios[]

  @@map("usuarios")
}

model EmpresaUsuarios {
  id          Int       @id @default(autoincrement())
  id_usuario  Int
  id_empresa  Int
  dt_admissao DateTime? @db.Date
  perfil      String    @db.VarChar(11)
  status      Boolean   @default(true)

  dh_criacao   DateTime @default(now())
  dh_alteracao DateTime @default(now())

  usuario Usuarios @relation(fields: [id_usuario], references: [id])
  empresa Empresas @relation(fields: [id_empresa], references: [id])

  @@map("empresa_usuarios")
}

model Empresas {
  id                Int @id @default(autoincrement())
  id_grupo_empresas Int
  cod_empresa       Int

  cpf_cnpj String  @db.VarChar(14)
  xNome    String  @db.VarChar(60)
  xFant    String? @db.VarChar(60)
  xLgr     String? @db.VarChar(60)
  numero   String? @db.VarChar(60)
  xCpl     String? @db.VarChar(60)
  fone     String? @db.VarChar(15)

  status Boolean @default(true)

  dh_criacao   DateTime @default(now())
  dh_alteracao DateTime @default(now())

  pedidos         Pedidos[]
  grupoEmpresas   GrupoEmpresas     @relation(fields: [id_grupo_empresas], references: [id])
  empresaUsuarios EmpresaUsuarios[]

  @@map("empresas")
}

model GrupoEmpresas {
  id                      Int @id @default(autoincrement())
  id_usuario_proprietario Int

  usuario  Usuarios   @relation(fields: [id_usuario_proprietario], references: [id])
  empresas Empresas[]

  @@map("grupo_empresas")
}

model Clientes {
  id                 Int       @id @default(autoincrement())
  id_empresa         Int
  nome               String    @db.VarChar(120)
  apelido            String?   @db.VarChar(120)
  endereco           String?   @db.VarChar(250)
  fone               String?   @db.VarChar(15)
  status             Boolean   @default(true)
  limite_credito     Decimal   @default(0) @db.Decimal(10, 4)
  data_nascimento    DateTime? @db.Date
  id_usuario_criador Int

  dh_criacao   DateTime  @default(now())
  dh_alteracao DateTime  @default(now())
  Pedidos      Pedidos[]

  @@map("clientes")
}

model Produtos {
  id           Int  @id @default(autoincrement())
  id_categoria Int? // Chave estrangeira ?-> não obrigatório.

  nomeProduto  String   @db.VarChar(80)
  descricao    String?  @db.VarChar(1000)
  preco        Decimal  @default(0) @db.Decimal(10, 4)
  status       Boolean  @default(true)
  imagemUrl    String?
  dh_criacao   DateTime @default(now())
  dh_alteracao DateTime @default(now())

  categoria Categorias? @relation(fields: [id_categoria], references: [id])

  pedidoProdutos    PedidoProdutos[]
  grupoComplementos GrupoComplementos[]

  @@map("produtos") // Força nome minúsculo na migration
}

model Categorias {
  id        Int        @id @default(autoincrement())
  descricao String
  produtos  Produtos[]

  @@map("categorias") // Força nome minúsculo na migration
}

model GrupoComplementos {
  id        Int @id @default(autoincrement())
  idProduto Int

  nomeGrupoComplementos String  @db.VarChar(40)
  descricao             String? @db.VarChar(200)

  obrigatorio       Boolean
  qtdMinComplemento Int
  qtdMaxComplemento Int

  produtos Produtos? @relation(fields: [idProduto], references: [id])

  dh_criacao   DateTime @default(now())
  dh_alteracao DateTime @default(now())

  Complementos Complementos[]

  @@map("grupocomplementos") // Força nome minúsculo na migration
}

model Complementos {
  id                  Int  @id @default(autoincrement())
  idGrupoComplementos Int?

  nomeComplemento String  @db.VarChar(80)
  descricao       String? @db.VarChar(200)
  status          Boolean @default(true)
  preco           Decimal @default(0) @db.Decimal(10, 4)
  imagemUrl       String?

  grupoComplementos GrupoComplementos? @relation(fields: [idGrupoComplementos], references: [id])

  dh_criacao                DateTime                    @default(now())
  dh_alteracao              DateTime                    @default(now())
  PedidoProdutoComplementos PedidoProdutoComplementos[]

  @@map("complementos") // Força nome minúsculo na migration
}

model Pedidos {
  id         Int @id @default(autoincrement())
  id_empresa Int
  idCliente  Int

  nomeCliente String @db.VarChar(120)

  observacao String? @db.VarChar(250)

  valorSubTotal      Decimal  @default(0) @db.Decimal(10, 4)
  valorTotal         Decimal  @db.Decimal(10, 4)
  valorTaxaDeEntrega Decimal? @db.Decimal(10, 4)

  status       Int
  localConsumo Int

  dh_criacao   DateTime @default(now())
  dh_alteracao DateTime @default(now())

  cliente Clientes @relation(fields: [idCliente], references: [id])
  empresa Empresas @relation(fields: [id_empresa], references: [id])

  itensPedido PedidoProdutos[]

  @@map("pedidos") // Força nome minúsculo na migration
}

model PedidoProdutos {
  id         Int @id @default(autoincrement())
  id_produto Int // Chave estrangeira
  id_pedido  Int // Chave estrangeira

  precoUnitario  Decimal @db.Decimal(10, 4)
  quantidade     Int
  observacaoItem String? @db.VarChar(200)

  produtos         Produtos                    @relation(fields: [id_produto], references: [id])
  pedidos          Pedidos                     @relation(fields: [id_pedido], references: [id], onDelete: Cascade)
  complementosItem PedidoProdutoComplementos[]

  @@map("pedido_produtos") // Força nome minúsculo na migration
}

model PedidoProdutoComplementos {
  id              Int @id @default(autoincrement())
  idComplemento   Int
  idProdutoPedido Int

  precoUnitario Decimal @db.Decimal(10, 4)
  quantidade    Int

  complementos  Complementos   @relation(fields: [idComplemento], references: [id])
  pedidoProduto PedidoProdutos @relation(fields: [idProdutoPedido], references: [id], onDelete: Cascade)

  @@map("pedido_produto_complementos")
}

/**
 * ------------- Configuarações --------------------
 */
model TaxasDeEntrega {
  id Int @id @default(autoincrement())

  bairroRegiao String  @db.VarChar(80)
  valor        Decimal @default(0) @db.Decimal(10, 2)

  dh_criacao   DateTime @default(now())
  dh_alteracao DateTime @default(now())

  @@map("taxas_entrega")
}
